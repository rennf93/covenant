{
  "name": "@covenant/indexer",
  "version": "0.1.0",
  "description": "Event-sourced indexer and JSON API for the Covenant protocol",
  "type": "module",
  "main": "./src/main.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "pnpm run build && node --test \"dist/test/*.test.js\"",
    "start": "tsx src/main.ts 2>/dev/null || node --experimental-strip-types src/main.ts"
  },
  "dependencies": {
    "viem": "^2.57.1",
    "@covenant/sdk": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^26.6.3"
  }
}