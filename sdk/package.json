{
  "name": "@proven/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Proven: onchain proof-of-performance for trading strategies",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "pnpm run build && node --test dist/test/*.test.js",
    "gen-fixtures": "tsx scripts/gen-fixtures.ts 2>/dev/null || node --experimental-strip-types scripts/gen-fixtures.ts"
  },
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}