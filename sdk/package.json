{
  "name": "@covenant/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Covenant: onchain proof-of-performance for trading strategies",
  "type": "module",
  "main": "./dist/src/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build",
    "test": "pnpm run build && node --test dist/test/*.test.js",
    "finalize": "pnpm run build && node scripts/finalize-due.ts"
  },
  "dependencies": {
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^5.6.0"
  },
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  }
}
