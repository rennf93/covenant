# Configuration (copy to .env or export in your shell)
# Nothing here is required for shadow mode except nothing at all.

# --- System-1 (the decision head). Choose: local | server | openrouter ---
# local: laya checkpoint in-process (needs laya installed; slow cold start)
# server: a running laya.serve HTTP server (recommended; ~0.2s warm)
# VOUCH_S1_PROVIDER=server
# VOUCH_S1_URL=http://127.0.0.1:9989
# VOUCH_S1_API_KEY=<LAYA_API_KEY the server was started with>
# openrouter: any OpenAI-compatible chat endpoint via OpenRouter
# VOUCH_S1_PROVIDER=openrouter
# VOUCH_S1_API_KEY=<OPENROUTER_KEY>
# VOUCH_S1_MODEL=openai/gpt-4o-mini
# VOUCH_S1_BASE_URL=https://openrouter.ai/api/v1   (optional override)

# --- System-2 (the rule rewriter). Any OpenAI-compatible llama.cpp server ---
VOUCH_S2_BASE_URL=http://127.0.0.1:9998/v1
VOUCH_S2_MODEL=qwen3.8-27b
VOUCH_S2_KEY=<COLI_API_KEY>

# --- THE FLIP: shadow -> live. Leave unset for paper. ---
# VOUCH_VENUE=coinbase
# VOUCH_CB_KEY_NAME=organizations/<org>/apiKeys/<key>
# VOUCH_CB_PRIVATE_KEY=<base64 EC private key from CDP>
# VOUCH_CB_PRODUCT=SOL-USD

# --- Fee model: per-side taker fee in basis points (default 60, retail) ---
# VOUCH_FEE_BPS=60

# --- Calibrated-edge gate (written by run_analysis.py --fit) ---
# VOUCH_CALIBRATION=out/calibration.json

# --- Dashboard (run_ui.py) ---
# Refuses to start real-money runs unless this is set in the SERVER's
# environment AND the request confirms AND Coinbase keys are configured.
# VOUCH_UI_ALLOW_REAL=1

# --- Covenant attestation (operator/attest) ---
# Ledger-only by default: receipts + evidence bundles are written but nothing
# touches the chain. Flip COVENANT_ATTEST=1 to enable the chain path, which then
# also requires the three connection vars below.
# COVENANT_ATTEST=1
# COVENANT_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# COVENANT_PRIVATE_KEY=<funded operator EOA key>
# COVENANT_CONTRACT_ADDRESS=<Covenant Stylus proxy address>
# COVENANT_CHAIN=arbitrum-sepolia
# COVENANT_STRATEGY_ID=0
# COVENANT_STRATEGY_NAME=vouch-sol
# Defaults for `run_register.py` when --name/--metadata-uri are omitted:
# COVENANT_STRATEGY_METADATA_URI=
# Evidence root: bundles land at <evidence_dir>/<run_id>/epoch-N.json and the
# commit references that stable relative path (default "evidence" next to the
# runners). Per-run copies always land under out/<run_id>/evidence/ too.
# COVENANT_EVIDENCE_DIR=evidence
# Optional: kubo RPC base URL. When set, the bundle is pinned to IPFS and the
# commit references ipfs://<cid> instead of the relative path. Publishing
# failures are logged and never fail a commit.
# COVENANT_IPFS_API=http://127.0.0.1:5001
